# Claude
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-sonnet-5-5
TRIAGE_EFFORT=medium            # low | medium | high | xhigh | max
TRIAGE_TIME_BUDGET_S=100        # agent wall-clock budget; leaves headroom inside the 2-minute SLA
TRIAGE_MAX_TURNS=14

# Safeguards
TRIAGE_MAX_CONCURRENT=4         # triages running at once
TRIAGE_MAX_QUEUED=20            # running plus waiting; beyond this, incidents are refused
TRIAGE_MAX_PER_DAY=500          # hard daily cap, which also limits API spend
TRIAGE_AUDIT_LOG=data/audit.jsonl
TRIAGE_KILL_SWITCH_FILE=data/TRIAGE_DISABLED   # while this file exists, nothing is triaged

# Service catalog: maps alert service names to repo, Datadog tags, runbooks
TRIAGE_SERVICE_CATALOG=config/services.yaml

# Datadog (use an application key scoped to *_read permissions only)
DD_SITE=datadoghq.com
DD_API_KEY=
DD_APP_KEY=

# GitHub (fine-grained token: Contents, Deployments, Pull requests = read-only)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# ServiceNow (integration user with the snc_read_only role + itil read ACLs)
SNOW_INSTANCE=yourbank.service-now.com
SNOW_USER=
SNOW_PASSWORD=
SNOW_WEBHOOK_TOKEN=             # shared secret sent by the outbound REST message

# PagerDuty (read-only REST API key + v3 webhook signing secret)
PAGERDUTY_API_KEY=
PAGERDUTY_WEBHOOK_SECRET=

# Slack (bot token needs chat:write only; signing secret for feedback buttons)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#oncall-triage
SLACK_SIGNING_SECRET=

# Where accept/reject feedback from on-call engineers is recorded
TRIAGE_FEEDBACK_LOG=data/feedback.jsonl
